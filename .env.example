# GoHighLevel Private Integration (api/lead.js). Vercel → Settings → Environment Variables. Never commit values.
GHL_PRIVATE_TOKEN=
GHL_LOCATION_ID=
# Shopify Headless channel, private Storefront token (api/checkout.js). Optional: without it checkout runs tokenless. Domain defaults to exq8kt-ty.myshopify.com.
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
SHOPIFY_STORE_DOMAIN=
